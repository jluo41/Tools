diff --git a/test/file-activity.test.js b/test/file-activity.test.js
new file mode 100644
index 0000000..5f1a1b3
--- /dev/null
+++ b/test/file-activity.test.js
@@ -0,0 +1,61 @@
+import assert from 'node:assert/strict'
+import test from 'node:test'
+import { createFileActivity, fileActivityRoute } from '../lib/file-activity.js'
+
+const workspace = { bound: true, ws: '/project', pool: { platform: 'posix' } }
+const path = '/project/reports/week/report.md'
+const done = { ok: true, change: { unchanged: false } }
+
+test('reports pending writes and collapsed ancestors, then retains a bounded changed mark', async () => {
+  let time = 200
+  const activity = createFileActivity({ now: () => time, retentionMs: 100 })
+  const pending = Promise.withResolvers()
+  const operation = activity.run(workspace, path, () => pending.promise)
+  assert.deepEqual(activity.snapshot(workspace), [{ path, parents: ['/project/reports/week', '/project/reports', '/project'], pending: true, revision: 0 }])
+  assert.deepEqual(activity.snapshot({ ...workspace, ws: '/other' }), [])
+  assert.deepEqual(activity.snapshot({ ...workspace, pool: {} }), [])
+  pending.resolve(done)
+  assert.equal(await operation, done)
+  assert.equal(activity.snapshot(workspace)[0].pending, false)
+  assert.equal(activity.snapshot(workspace)[0].revision, 1)
+  time += 100
+  assert.deepEqual(activity.snapshot(workspace), [])
+})
+
+test('failed, unchanged and out-of-workspace writes do not claim a change', async () => {
+  const activity = createFileActivity()
+  await assert.rejects(activity.run(workspace, path, () => { throw new Error('conflict') }), /conflict/)
+  await activity.run(workspace, path, () => ({ ok: true, change: { unchanged: true } }))
+  await activity.run(workspace, '/project-other/report.md', () => done)
+  assert.deepEqual(activity.snapshot(workspace), [])
+})
+
+test('overlapping writes keep the ring until the last operation settles', async () => {
+  const activity = createFileActivity()
+  const first = Promise.withResolvers()
+  const second = Promise.withResolvers()
+  const left = activity.run(workspace, path, () => first.promise)
+  const right = activity.run(workspace, path, () => second.promise)
+  first.resolve(done)
+  await left
+  assert.equal(activity.snapshot(workspace)[0].pending, true)
+  second.reject(new Error('conflict'))
+  await assert.rejects(right, /conflict/)
+  assert.equal(activity.snapshot(workspace)[0].pending, false)
+  assert.equal(activity.snapshot(workspace)[0].revision, 1)
+})
+
+test('the read endpoint requires a session and passes binding errors through', async () => {
+  const activity = createFileActivity()
+  await activity.run(workspace, path, () => done)
+  const route = fileActivityRoute({ activity, sendJson: (_, status, json) => ({ status, json }),
+    resolveRequestBinding(req) {
+      if (!req.url.includes('sessionId=accepted')) throw Object.assign(new Error('mismatch'), { httpStatus: 403 })
+      return workspace
+    },
+  })
+  const call = (query) => route.handler({ method: 'GET', url: route.path + query }, {})
+  assert.equal((await call('')).status, 400)
+  assert.equal((await call('?sessionId=wrong')).status, 403)
+  assert.equal((await call('?sessionId=accepted')).json.files[0].path, path)
