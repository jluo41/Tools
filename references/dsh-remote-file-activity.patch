diff --git a/lib/file-activity.js b/lib/file-activity.js
new file mode 100644
index 0000000..c5896a6
--- /dev/null
+++ b/lib/file-activity.js
@@ -0,0 +1,81 @@
+import { normalizeRemotePath, relPathUnder, remoteDirname, toDisplayPath } from './paths.js'
+import { requestSessionHint } from './binding.js'
+
+// Presentation only: never store file contents or make additional SSH calls.
+export function createFileActivity({ now = Date.now, retentionMs = 5 * 60_000 } = {}) {
+  const pools = new WeakMap()
+  let revision = 0
+  function entries(binding, create = false) {
+    if (!binding.bound || binding.local || !binding.ws) return
+    let roots = pools.get(binding.pool)
+    if (!roots && create) pools.set(binding.pool, roots = new Map())
+    const root = normalizeRemotePath(binding.ws)
+    let files = roots?.get(root)
+    if (!files && create) roots.set(root, files = new Map())
+    if (!files) return
+    const cutoff = now() - retentionMs
+    for (const [path, item] of files) if (!item.pending && (item.savedAt == null || item.savedAt <= cutoff)) files.delete(path)
+    return files
+  }
+  async function run(binding, path, write) {
+    const relative = binding.ws && relPathUnder(binding.ws, path)
+    if (!relative) return write()
+    const files = entries(binding, true)
+    if (!files) return write()
+    const canonical = normalizeRemotePath(path)
+    const item = files.get(canonical) || { pending: 0 }
+    files.set(canonical, item)
+    item.pending++
+    try {
+      const result = await write()
+      if (result?.ok && !result.change?.unchanged) {
+        item.savedAt = now()
+        item.revision = ++revision
+      }
+      return result
+    } finally {
+      item.pending--
+      if (!item.pending && item.savedAt == null) files.delete(canonical)
+      if (files.size > 256) {
+        const completed = [...files].filter(([, value]) => !value.pending).sort((a, b) => a[1].revision - b[1].revision)
+        for (const [oldPath] of completed) {
+          if (files.size <= 256) break
+          files.delete(oldPath)
+        }
+      }
+    }
+  }
+  function snapshot(binding) {
+    const files = entries(binding)
+    const display = (path) => toDisplayPath(path, binding.pool.platform)
+    return [...(files || [])].map(([path, item]) => {
+      const parents = []
+      let dir = remoteDirname(path)
+      while (relPathUnder(binding.ws, dir) != null) {
+        parents.push(display(dir))
+        const next = remoteDirname(dir)
+        if (next === dir || !relPathUnder(binding.ws, dir)) break
+        dir = next
+      }
+      return { path: display(path), parents, pending: !!item.pending, revision: item.revision || 0 }
+    })
+  }
+  return { run, snapshot }
+}
+
+export function fileActivityRoute({ activity, sendJson, resolveRequestBinding }) {
+  return {
+    kind: 'exact', path: '/dsh-remote/file-activity',
+    async handler(req, res) {
+      if (req.method !== 'GET') return sendJson(res, 405, { error: 'method not allowed' })
+      if (!requestSessionHint(req).sessionId) return sendJson(res, 400, { error: 'sessionId is required' })
+      try {
+        const binding = await resolveRequestBinding(req)
+        res.setHeader?.('Cache-Control', 'no-store')
+        return sendJson(res, 200, { files: activity.snapshot(binding) })
+      } catch (err) {
+        return sendJson(res, err.httpStatus || 500, { error: String(err.message || err) })
+      }
+    },
+  }
+}
