.DS_Store
__pycache__/
*.pyc

# diagram-ascii-canvas intermediate renders
**/_pngs/

# Venue exemplar PDFs — copyrighted published papers, kept local only (public repo)

# QC9 (JL 260731): the board/ tree is derived output, rebuilt by `build.py --split`.
# board.html stays tracked as the one-file artifact; the tree would add ~60 files
# per board of pure noise to every diff.
#
# ⚠️ ANCHORED ON PURPOSE. A bare `**/board/` would also match
# `plugins/haipipe-toolkit/skills/board/`, the skill family itself, and silently
# untrack the whole thing. Match only the generated tree inside a board folder.
plugins/haipipe-toolkit/skills/diagrams/*/board/

# ── Bulk data never enters git ──────────────────────────────────────────────
# This is a skills repo, so none of this should ever appear. The rule is here
# because a task or demo that writes a parquet beside its code would otherwise
# be committed silently, and git never forgets a large file.
*.parquet
*.pkl
*.feather
*.arrow
*.npy
*.npz
*.h5
*.hdf5
*.sqlite
*.db
*.zip
*.tar
*.tar.gz
*.tgz

# The served board's local state: the activity database and the session
# sidecar. Both are per-machine (sessions.json stores absolute paths) and
# both self-create when missing, so they are never shared.
.haipipe-board/
