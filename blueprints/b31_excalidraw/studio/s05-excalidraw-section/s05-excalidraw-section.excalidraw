   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A Section map goes to <page folder>/studio/<stem>-sections.excalidraw; a paper map to <paper\nfolder>/studio/paper-sections.excalidraw. Story > RoadMap Draw lists what is in studio/. A map someone edited on the\ncanvas is kept unless the script is run again with --force, and every map's source field names the script that made it, so a\nreader can tell it was generated.",
   "originalText": "A Section map goes to <page folder>/studio/<stem>-sections.excalidraw; a paper map to <paper\nfolder>/studio/paper-sections.excalidraw. Story > RoadMap Draw lists what is in studio/. A map someone edited on the\ncanvas is kept unless the script is run again with --force, and every map's source field names the script that made it, so a\nreader can tell it was generated.",
   "fontSize": 28,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
