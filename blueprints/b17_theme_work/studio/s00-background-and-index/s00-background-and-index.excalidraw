   "roundness": null,
   "seed": 64,
   "version": 1,
   "versionNonce": 64,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The work Theme runs bounded execution work: a Task plans,\nbuilds, executes and reports, and each Run is one hard ticket\n(rNN_<noun>_<qualifier>.sh) with its Result and receipt.",
   "originalText": "The work Theme runs bounded execution work: a Task plans,\nbuilds, executes and reports, and each Run is one hard ticket\n(rNN_<noun>_<qualifier>.sh) with its Result and receipt.",
   "fontSize": 20,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-30318585784e",
   "type": "text",
   "x": 838.0,
   "y": 431.0,
   "width": 565.4025,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-25eae3364a1a",
   "roundness": null,
   "seed": 65,
   "version": 1,
   "versionNonce": 65,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Its Block is a task Block (tasks/bNN_<topic>/), a Job groups\nTasks by series (j0N, j1N, j5N), and a Block's Questions are\nanswered by report Pages that read the Tasks' Runs.",
   "originalText": "Its Block is a task Block (tasks/bNN_<topic>/), a Job groups\nTasks by series (j0N, j1N, j5N), and a Block's Questions are\nanswered by report Pages that read the Tasks' Runs.",
   "fontSize": 20,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-3f8cfdec542a",
   "type": "text",
   "x": 838.0,
   "y": 512.0,
   "width": 593.260625,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-25eae3364a1a",
   "roundness": null,
   "seed": 66,
   "version": 1,
   "versionNonce": 66,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Today the Task workbench shows it at Block level in four\nSpaces (Scope · Task · Check · Delivery): the Question groups\nare Views of Task.",
   "originalText": "Today the Task workbench shows it at Block level in four\nSpaces (Scope · Task · Check · Delivery): the Question groups\nare Views of Task.",
   "fontSize": 20,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
