  {
   "id": "s-31d859652c0c",
   "type": "text",
   "x": 838.0,
   "y": 350.0,
   "width": 583.853125,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
