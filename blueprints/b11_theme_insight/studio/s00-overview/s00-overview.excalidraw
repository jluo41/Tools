  {
   "id": "s-99e5b441aac8",
   "type": "text",
   "x": 108.0,
   "y": 500.5,
   "width": 583.9193750000001,
   "height": 50.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
