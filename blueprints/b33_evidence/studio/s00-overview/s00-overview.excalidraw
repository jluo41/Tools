   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The skill was born inside b32_draft (s41, s21) and on b21's C2\nSection canvas (WellDoc-SPACE, Project-SHIFT-Study, b21\ns05);",
   "originalText": "The skill was born inside b32_draft (s41, s21) and on b21's C2\nSection canvas (WellDoc-SPACE, Project-SHIFT-Study, b21\ns05);",
