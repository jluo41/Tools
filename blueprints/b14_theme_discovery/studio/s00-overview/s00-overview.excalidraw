   "versionNonce": 66,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Today the Discovery workbench shows it at Block level in four\nSpaces (Scope · Work · Check · Delivery): Papers, Tasks and\nQuestions are Views of Work;",
   "originalText": "Today the Discovery workbench shows it at Block level in four\nSpaces (Scope · Work · Check · Delivery): Papers, Tasks and\nQuestions are Views of Work;",
