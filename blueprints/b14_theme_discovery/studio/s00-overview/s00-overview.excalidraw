   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The discovery Theme reads outside evidence: it finds papers\nand sources, reviews each one through a numbered Paper Run\n(rNN_<author><year>_<subject>/: a Result Card, facts, a\nruntime receipt, one BibTeX entry), and …",
   "originalText": "The discovery Theme reads outside evidence: it finds papers\nand sources, reviews each one through a numbered Paper Run\n(rNN_<author><year>_<subject>/: a Result Card, facts, a\nruntime receipt, one BibTeX entry), and …",
   "fontSize": 20,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
