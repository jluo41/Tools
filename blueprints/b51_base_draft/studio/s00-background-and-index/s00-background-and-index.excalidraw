   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "This Block asks whether the base layer should be named and\ntaught as the Draft, what a draft folder holds, and how every\ntheme (a paper Section, a report, a cowork email, a discovery\nor insight page) uses the same draft.",
   "originalText": "This Block asks whether the base layer should be named and\ntaught as the Draft, what a draft folder holds, and how every\ntheme (a paper Section, a report, a cowork email, a discovery\nor insight page) uses the same draft.",
