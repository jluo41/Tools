  },
  {
   "id": "s-0c4d7d17b723",
   "type": "text",
   "x": 70,
   "y": 7442.9,
   "width": 931.7,
   "height": 55.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
