   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "6. When a cited studio frame changes, flag the report for review before its\nanswer changes?",
   "originalText": "6. When a cited studio frame changes, flag the report for review before its\nanswer changes?",
   "fontSize": 22,
   "fontFamily": 6,
