  },
  {
   "id": "s-6a86765b7a33",
   "type": "text",
   "x": 70,
   "y": 7784.9,
   "width": 919.6,
   "height": 55.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
