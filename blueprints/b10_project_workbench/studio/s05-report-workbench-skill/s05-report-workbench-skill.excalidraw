   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-bb291745ed01",
   "type": "text",
   "x": 70,
   "y": 7514.1,
   "width": 907.5000000000001,
   "height": 55.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
