  {
   "id": "s-23d86b2a8148",
   "type": "text",
   "x": 2940,
   "y": 386,
   "width": 809.1999999999999,
   "height": 715.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
