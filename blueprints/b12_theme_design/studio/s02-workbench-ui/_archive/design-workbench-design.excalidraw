   "versionNonce": 1274895943,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790467200000,
   "link": null,
   "locked": false,
   "text": "1. Each Space shows every Design Item; a selected item or page sets the Runs target.\n2. Each Space lists its own run types: Design has Commission · Generate · Verify.\n3. Pick a run to see its prompt (copy it to run it yourself), its process and its results.\n4. Rerun and Revise start a new run; a draft is never overwritten.\n5. Delivery shows every live design as the patient sees it; nothing to adopt.",
   "originalText": "1. Each Space shows every Design Item; a selected item or page sets the Runs target.\n2. Each Space lists its own run types: Design has Commission · Generate · Verify.\n3. Pick a run to see its prompt (copy it to run it yourself), its process and its results.\n4. Rerun and Revise start a new run; a draft is never overwritten.\n5. Delivery shows every live design as the patient sees it; nothing to adopt.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "index": "b2O"
  },
