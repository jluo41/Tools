 1, "link": null, "locked": false}, {"id": "kept_s-b0fd59aa6b39", "type": "text", "x": 2480.0, "y": 3394.0, "width": 420.75, "height": 84.375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-41696548c151", "roundness": null, "seed": 1176886776, "version": 1, "versionNonce": 816545283, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "idea: base keeps the Task folder\ncontract; work gets the lifecycle,\nworkbench-work, task-for-* kinds", "originalText": "idea: base keeps the Task folder\ncontract; work gets the lifecycle,\nworkbench-work, task-for-* kinds", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": "kept_s-7f42e3cfc7eb", "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-ed456b77f593", "type": "rectangle", "x": 3050.0, "y": 3379.0, "width": 550.0, "height": 122.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "s-41696548c151", "roundness": {"type": 3}, "seed": 1581891896, "version": 1, "versionNonce": 180930718, "isDeleted": false, "boundElements": [{"type": "text", "id": "kept_s-f6db42f93aae"}], "updated": 1, "link": null, "locked": false}, {"id": "kept_s-f6db42f93aae", "type": "text", "x": 3067.5, "y": 3394.0, "width": 420.75, "height": 84.375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-41696548c151", "roundness": null, "seed": 1915124081, "version": 1, "versionNonce": 750312566, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "your call: the ML pipeline (data ·\nnn · end · individual) into work,\nor its own theme?", "originalText": "your call: the ML pipeline (data ·\nnn · end · individual) into work,\nor its own theme?", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": "kept_s-ed456b77f593", "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-d9c330125481", "type": "text", "x": 4300.0, "y": 2890.0, "width": 935.0000000000001, "height": 106.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1443836627, "version": 1, "versionNonce": 686364358, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Not for the move. SMSDesign's 16 Pages resolve. SMSEngagement's 32 use the\nTools/plugins/... form, which never resolved (some even name workflow-phases/),\nso their structure check was already off. The fix is editing those 32 Pages\nto 2_theme/paper/venue/...; it turns the check on, so it is that project's call.", "originalText": "Not for the move. SMSDesign's 16 Pages resolve. SMSEngagement's 32 use the\nTools/plugins/... form, which never resolved (some even name workflow-phases/),\nso their structure check was already off. The fix is editing those 32 Pages\nto 2_theme/paper/venue/...; it turns the check on, so it is that project's call.", "fontSize": 21, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-dd53ab9e9bb8", "type": "text", "x": 3437.5, "y": 2477.5, "width": 923.3125000000001, "height": 106.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1474916941, "version": 1, "versionNonce": 1998761940