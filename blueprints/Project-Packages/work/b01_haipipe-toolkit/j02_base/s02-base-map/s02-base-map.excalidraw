eId": null, "roundness": null, "seed": 1540347922, "version": 1, "versionNonce": 1709635374, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Called by (almost) every theme:\npage, project, question, task", "originalText": "Called by (almost) every theme:\npage, project, question, task", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": "kept_s-f450fea3577f", "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-37570c1af049", "type": "rectangle", "x": 2262.5, "y": 1921.25, "width": 750.0, "height": 93.50000000000001, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 694946100, "version": 1, "versionNonce": 873754689, "isDeleted": false, "boundElements": [{"type": "text", "id": "kept_s-ccb95c7bd356"}], "updated": 1, "link": null, "locked": false}, {"id": "kept_s-ccb95c7bd356", "type": "text", "x": 2280.0, "y": 1936.25, "width": 544.5, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1797297820, "version": 1, "versionNonce": 1098059531, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A single-caller base skill is a candidate to\nmove into its one theme (Q03 decides).", "originalText": "A single-caller base skill is a candidate to\nmove into its one theme (Q03 decides).", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": "kept_s-37570c1af049", "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-00e984962958", "type": "rectangle", "x": 3062.5, "y": 1921.25, "width": 750.0, "height": 93.50000000000001, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 1490112895, "version": 1, "versionNonce": 1569537756, "isDeleted": false, "boundElements": [{"type": "text", "id": "kept_s-46047d36ff66"}], "updated": 1, "link": null, "locked": false}, {"id": "kept_s-46047d36ff66", "type": "text", "x": 3080.0, "y": 1936.25, "width": 544.5, "height": 56.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1493537692, "version": 1, "versionNonce": 467747490, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A theme naming another theme's skills breaks\nthe layer rule (red rows in theme x theme).", "originalText": "A theme naming another theme's skills breaks\nthe layer rule (red rows in theme x theme).", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": "kept_s-00e984962958", "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-d97793a89ce3", "type": "text", "x": 1462.5, "y": 2171.25, "width": 1237.5000000000002, "height": 28.125, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1857201693, "version": 1, "versionNonce": 781020543, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "? Counts are files that NAME a skill: a mention in a doc counts like a call in code. Good for a map,", "originalText": "? Counts are files that NAME a skill: a mention in a doc counts like a call in code. Good for a map,", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-d31806de0079", "type": "text", "x": 1462.5, "y": 2206.875, "width": 891.0000000000001, "height": 28.125, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 488121826, "version": 1, "versionNonce": 802040319, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "  not proof of a dependency; s03 can split code calls from doc mentions.", "originalText": "  not proof of a dependency; s03 can split code calls from doc mentions.", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-ef246b9b5981", "type": "text", "x": 1462.5, "y": 2242.5, "width": 2425.5, "height": 28.125, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 289416443, "version": 1, "versionNonce": 1932939204, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "? Themes naming other themes' skills: paper names discovery (5); discovery names paper (5); design names discovery (3); insight names discovery (2). Real dependencies, or just cross-links in docs?", "originalText": "? Themes naming other themes' skills: paper names discovery (5); discovery names paper (5); design names discovery (3); insight names discovery (2). Real dependencies, or just cross-links in docs?", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-2a610c798590", "type": "tex