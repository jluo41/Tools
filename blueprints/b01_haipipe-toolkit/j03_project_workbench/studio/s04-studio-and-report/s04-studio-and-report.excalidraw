   "versionNonce": 1,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "✎ 261010 qNN is the pair's identity; rNN remains a Run",
   "originalText": "✎ 261010 qNN is the pair's identity; rNN remains a Run",
   "fontSize": 17,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-abe42b05445c",
   "type": "text",
   "x": 1360,
   "y": 1025,
   "width": 693.0,
   "height": 78.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-6ef84d655857",
   "roundness": null,
   "seed": 373574288,
   "version": 1,
   "versionNonce": 62186605,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A frame is a visual source. A Question names what to answer.\nIts Report records what we can say now.\nThey are linked, so drawing and answering stay together.",
   "originalText": "A frame is a visual source. A Question names what to answer.\nIts Report records what we can say now.\nThey are linked, so drawing and answering stay together.",
   "fontSize": 21,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-79285a826a71",
   "type": "text",
   "x": 80,
   "y": 1260,
   "width": 1222.1000000000001,
   "height": 27.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-6ef84d655857",
   "roundness": null,
   "seed": 2016672032,
   "version": 1,
   "versionNonce": 1058297504,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Shared across themes and levels: a Block's Studio holds shared thinking; a Job or Task holds its own.",
   "originalText": "Shared across themes and levels: a Block's Studio holds shared thinking; a Job or Task holds its own.",
   "fontSize": 22,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
