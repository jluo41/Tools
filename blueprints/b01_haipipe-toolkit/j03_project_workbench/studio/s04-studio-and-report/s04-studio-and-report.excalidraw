  },
  {
   "id": "s-4fa1d1850fa0",
   "type": "text",
   "x": 1360,
   "y": 860,
   "width": 556.6,
   "height": 86.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-6ef84d655857",
   "roundness": null,
   "seed": 1051513361,
   "version": 1,
   "versionNonce": 1494896913,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Default: one primary frame per Question.\nA Question can cite extra supporting frames.\nBackground frames can feed several Reports.",
   "originalText": "Default: one primary frame per Question.\nA Question can cite extra supporting frames.\nBackground frames can feed several Reports.",
   "fontSize": 23,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-b8fe00356ff4",
   "type": "text",
   "x": 1360,
   "y": 980,
   "width": 504.90000000000003,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
