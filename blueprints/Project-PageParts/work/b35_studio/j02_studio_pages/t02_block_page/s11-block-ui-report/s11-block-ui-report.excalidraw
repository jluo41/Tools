id", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1643469379, "version": 1, "versionNonce": 1490809118, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "1. The MindMap: the Block, one node per Studio\ngroup (its Tags), each sNN a leaf under its\ngroup; the Jobs after.", "originalText": "1. The MindMap: the Block, one node per Studio\ngroup (its Tags), each sNN a leaf under its\ngroup; the Jobs after.", "fontSize": 20, "fontFamily": 8, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rul2", "type": "text", "x": 2412.5, "y": 455.0, "width": 533.2, "height": 75.0, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1456113401, "version": 1, "versionNonce": 270469330, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "2. A leaf is the sNN's name and title, then\none plain paragraph: why, what it delivers,\nwhat is still open.", "originalText": "2. A leaf is the sNN's name and title, then\none plain paragraph: why, what it delivers,\nwhat is still open.", "fontSize": 20, "fontFamily": 8, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "autoResize": true}, {"id": "rul3", "type": "text", "x": 2412.5, "y": 557.5, "width": 570.4, "height": 75.0, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 151482832, "version": 1, "versionNonce": 392145441, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "3. Status lists the Studio first, one line per\