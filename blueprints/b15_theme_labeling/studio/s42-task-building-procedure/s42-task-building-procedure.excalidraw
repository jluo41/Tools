  },
  {
   "id": "s-c3fced408ccc",
   "type": "text",
   "x": 3040,
   "y": 1520.5,
   "width": 1637.46,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-bcb03628cf82",
   "roundness": null,
   "seed": 1229,
   "version": 1,
   "versionNonce": 1229,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· 7 pools each round: H, L, N when both models give that label, sure; HL, LN, HN between two; HLN when the definition does not cover it",
   "originalText": "· 7 pools each round: H, L, N when both models give that label, sure; HL, LN, HN between two; HLN when the definition does not cover it",
   "fontSize": 26,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-063e652459d5",
   "type": "text",
   "x": 3040,
   "y": 1559.0,
   "width": 1415.2,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-bcb03628cf82",
   "roundness": null,
   "seed": 1230,
   "version": 1,
   "versionNonce": 1230,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· the map flags 🧭 an H, L or N item whose gold neighbours differ; you rule the open pools and the 🧭, and that is gold",
   "originalText": "· the map flags 🧭 an H, L or N item whose gold neighbours differ; you rule the open pools and the 🧭, and that is gold",
   "fontSize": 26,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-e5f6fa8d6e77",
   "type": "text",
   "x": 3040,
   "y": 1597.5,
   "width": 1648.0600000000002,
   "height": 32.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "s-bcb03628cf82",
   "roundness": null,
   "seed": 1231,
   "version": 1,
   "versionNonce": 1231,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· Gold is only what you rule; H, L, N labels are kept, never gold. After a rule changes, every item is labeled again. Counts are an example.",
   "originalText": "· Gold is only what you rule; H, L, N labels are kept, never gold. After a rule changes, every item is labeled again. Counts are an example.",
   "fontSize": 26,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
