   "text": "· the sealed 50 are the final exam: untouched until scanning tests the models against your blind labels",
   "originalText": "· the sealed 50 are the final exam: untouched until scanning tests the models against your blind labels",
   "fontSize": 26,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
