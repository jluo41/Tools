   "link": null,
   "locked": false,
   "text": "The labeling Theme teaches and freezes what one identified\nperson means by a vague label (Building: contract, definition,\ncalibration rounds, guideline, the signed Label Handoff), then\nqualifies executors on a sealed …",
   "originalText": "The labeling Theme teaches and freezes what one identified\nperson means by a vague label (Building: contract, definition,\ncalibration rounds, guideline, the signed Label Handoff), then\nqualifies executors on a sealed …",
   "fontSize": 20,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
