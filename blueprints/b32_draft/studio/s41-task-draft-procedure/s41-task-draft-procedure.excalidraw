   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The accepted text is built, never edited by hand:\ntex, docx (tracked against the file it replaces) and\npdf; its pages are rendered so you see it as Word\nlays it out; only you send it. When the file comes\nback changed, it is read back and a new round\nstarts.",
   "originalText": "The accepted text is built, never edited by hand:\ntex, docx (tracked against the file it replaces) and\npdf; its pages are rendered so you see it as Word\nlays it out; only you send it. When the file comes\nback changed, it is read back and a new round\nstarts.",
   "fontSize": 30,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
