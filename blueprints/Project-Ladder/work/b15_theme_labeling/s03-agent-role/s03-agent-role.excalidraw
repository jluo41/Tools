: true, "lineHeight": 1.25}, {"id": "kept_s-complete-example-3", "type": "text", "x": 3217.5, "y": 2172.5, "width": 539.0578125000001, "height": 40.625, "angle": 0, "strokeColor": "#29394a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["node-example"], "frameId": null, "roundness": null, "seed": 68, "version": 1, "versionNonce": 68, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "A: “You are worrying over nothing.”", "originalText": "A: “You are worrying over nothing.”", "fontSize": 32, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-complete-example-4", "type": "text", "x": 3217.5, "y": 2228.125, "width": 527.58828125, "height": 81.25, "angle": 0, "strokeColor": "#29394a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["node-example"], "frameId": null, "roundness": null, "seed": 69, "version": 1, "versionNonce": 69, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "B: “I understand the concern; here\nis why I disagree.”", "originalText": "B: “I understand the concern; here\nis why I disagree.”", "fontSize": 32, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-complete-example-5", "type": "text", "x": 3217.5, "y": 2324.375, "width": 498.89375, "height": 81.25, "angle": 0, "strokeColor": "#29394a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": ["node-example"], "frameId": null, "roundness": null, "seed": 70, "version": 1, "versionNonce": 70, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "lock