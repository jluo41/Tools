ctangle", "x": 4470.0, "y": 5197.5, "width": 2980.0, "height": 287.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-folders", "roundness": {"type": 3}, "seed": 1464275860, "version": 1, "versionNonce": 769164997, "isDeleted": false, "boundElements": [], "updated": 0, "link": null, "locked": false}, {"id": "kept_rules-title", "type": "text", "x": 4500.0, "y": 5220.0, "width": 308.00000000000006, "height": 34.375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-folders", "roundness": null, "seed": 865245861, "version": 1, "versionNonce": 110818270, "isDeleted": false, "boundElements": [], "updated": 0, "link": null, "locked": false, "text": "Rules the page keeps", "originalText": "Rules the page keeps", "fontSize": 28, "fontFamily": 8, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_rules-text", "type": "text", "x": 4500.0, "y": 5270.0, "width": 974.4000000000001, "height": 125.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "frame-folders", "roundness": null, "seed": 1141848675, "version": 1, "versionNonce": 1962703527, "isDeleted": false, "boundElements": [], "updated": 0, "link": null, "locked": false, "text": "1. Item text appears only in Labeling › Rounds, and only for items already shown.\n2. A file observed on disk is never shown as a passed gate.\n3. The person is the only source of gold: a model's agreement never makes a label true.\n4. Held-back test items are never shown, counted from, or drawn into a round.\n5. The page stores nothing: it reads the job's files on every open.", "originalText": "1. Item text appears only in Labeling › Rounds, and only for items already shown.\n2. A file observed on disk is never shown as a passed gate.\n3. The person is the only source of gold: a model's agreement never makes a label true.\n4. Held-back test items are never shown, counted from, or drawn into a round.\n5. The page stores nothing: it reads the job's files on every open.", "fontSize": 20, "fontFamily": 8, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_frame-skills", "type": "frame", "x": 1400.0, "y": 587.5, "width": 6100.0, "height": 1390.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1701933378, "version": 1, "versionNonce": 1328488197, "isDeleted": false, "boundElements": [], "updated": 0, "link": null, "locked": false, "name": "Spaces, runs and skills"}, {"id": "kept_frame-workbench", "type": "frame", "x": 1400.0, "y": 1947.5, "width": 6100.0, "height": 1338.4375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 184841090, "version": 1, "versionNonce": 537364385, "isDeleted": false, "boundElements": [], "updated": 0, "link": null, "locked": false, "name": "The workbench"}, {"id": "kept_frame-views", "type": "frame", "x": 1400.0, "y": 3280.0, "width": 6100.0, "height": 1527.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 414051963, "version": 1, "versionNonce": 1066037552, "isDeleted": false