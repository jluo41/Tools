": null, "locked": false, "points": [[0.0, 0.0], [3100.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "kept_s-7089877c3848", "type": "line", "x": 1687.5, "y": 7474.375, "width": 3100.0, "height": 1.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-a87c2e309b22", "roundness": null, "seed": 1595, "version": 1, "versionNonce": 1595, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "points": [[0.0, 0.0], [3100.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "kept_s-da4311776611", "type": "text", "x": 1687.5, "y": 7499.375, "width": 3018.573046875, "height": 40.625, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-a87c2e309b22", "roundness": null, "seed": 1596, "version": 1, "versionNonce": 1596, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "🧮 Across pools, b is split by expected error mass: a pool's size in X (estimated from U) × its error rate in past audits; within a pool, the highest v(x) first. Stop when every pool's error mass is under ε.", "originalText": "🧮 Across pools, b is split by expected error mass: a pool's size in X (estimated from U) × its error rate in past audits; within a pool, the highest v(x) first. Stop when every pool's error mass is under ε.", "fontSize": 32, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-d010e67192a5", "type": "text", "x": 1687.5, "y": 7570.0, "width": 3051.09765625, "height": 81.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-a87c2e309b22", "roundness": null, "seed": 1597, "version": 1, "versionNonce": 1597, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "🔒 Two guards live in the tools, not in the agent: the final exam is not in the index, so no tool returns it; every item shown to anyone is logged, so we know what a person has seen; and each step has a\nreading budget (c_ask, c_pick, c_learn): past it, a tool returns ids, counts and labels, never text.", "originalText": "🔒 Two guards live in the tools, not in the agent: the final exam is not in the index, so no tool returns it; every item shown to anyone is logged, so we know what a person has seen; and each step has a\nreading budget (c_ask, c_pick, c_learn): past it, a tool returns ids, counts and labels, never text.", "fontSize": 32, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-28c824769fc1", "type": "rectangle", "x": 1682.5, "y": 7663.75, "width": 3110.0, "height": 60.625, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-a87c2e309b22", "roundness": {"type": 3}, "seed": 1598, "version": 1, "versionNonce": 1598, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false}, {"id": "kept_s-fd30abb95365", "type": "text", "x": 1692.5, "y": 7673.75, "width": 2904.540234375, "height": 40.625, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-a87c2e309b22", "roundness": null, "seed": 1599, "version": 1, "versionNonce": 1599, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "📏 At scale the rounds run on a development sample U of 2-5k items across the map's groups; the panel labels U every round; all of X is labeled only in scanning. DICES: U is the whole pool.", "originalText": "📏 At scale the rounds run on a development sample U of 2-5k items across the map's groups; the panel labels U every round; all of X is labeled only in scanning. DICES: U is the whole pool.", "fontSize": 32, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-ad0e5b4aa3fc", "type": "text", "x": 1687.5, "y": 7739.375, "width": 1727.590625, "height": 34.375, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "s-a87c2e309b22", "roundness": null, "seed": 1, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "✎ 261014 find_neighbours(seed, k, corpus, rank_by): one tool, five ways to rank · built: engine/corpus_tools.py (nearest works today)", "originalText": "✎ 261014 find_neighbours(seed, k, corpus, rank_by): one tool, five ways to rank · built: engine/corpus_tools.py (nearest works today)", "fontSize": 28, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-d7e6514028f7", "type": "frame", "x": 5087.5, "y": 5384.375, "width": 3212.5, "height": 991.875, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1601, "version": 1, "versionNonce": 1601, "isDeleted": false, "boundElements": [], "updat