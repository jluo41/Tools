   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "🔒 Three guards live in the tools: S only through the custodian's one logged door; every item shown is logged with who read it; each step's reading budget comes from the job's config (c_ask, c_pick, c_learn;\nr for the talk), and past it a tool returns ids and counts, never text.",
   "originalText": "🔒 Three guards live in the tools: S only through the custodian's one logged door; every item shown is logged with who read it; each step's reading budget comes from the job's config (c_ask, c_pick, c_learn;\nr for the talk), and past it a tool returns ids and counts, never text.",
   "fontSize": 26,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
