   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Talk with the corpus in passes: each pass the\nagent asks (👁 ≤ c_ask), you read a few items\nand write notes, it drafts the definition; another\npass, or Sign (G_1). At most r items read in all:\nthe set K, never drawn again.",
   "originalText": "Talk with the corpus in passes: each pass the\nagent asks (👁 ≤ c_ask), you read a few items\nand write notes, it drafts the definition; another\npass, or Sign (G_1). At most r items read in all:\nthe set K, never drawn again.",
   "fontSize": 30,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
