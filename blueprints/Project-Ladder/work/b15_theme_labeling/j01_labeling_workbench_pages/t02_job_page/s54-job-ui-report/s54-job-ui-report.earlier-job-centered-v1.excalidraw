      "isDeleted": false,
      "boundElements": [],
      "updated": 1793203352010,
      "link": null,
      "locked": false,
      "text": "Keep Building + Scanning together for now.\nSeparate Tasks only if they need separate ownership\nand independently reviewable outputs.",
      "originalText": "Keep Building + Scanning together for now.\nSeparate Tasks only if they need separate ownership\nand independently reviewable outputs.",
