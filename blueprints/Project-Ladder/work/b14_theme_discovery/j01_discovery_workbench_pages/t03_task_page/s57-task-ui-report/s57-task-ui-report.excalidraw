   "version": 1,
   "versionNonce": 1452444533,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MindMap · Status, as live (261108): a Task page has no Findings, so its Status holds 📚 Papers a side tab a paper, 📖 Evidence Bib its entries then the BibTeX, 🧾 Synthesis the topic summary,\nthen 🧪 Runs; its goal-line the question's Aim;\nevery section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms;\nthe right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "originalText": "MindMap · Status, as live (261108): a Task page has no Findings, so its Status holds 📚 Papers a side tab a paper, 📖 Evidence Bib its entries then the BibTeX, 🧾 Synthesis the topic summary,\nthen 🧪 Runs; its goal-line the question's Aim;\nevery section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms;\nthe right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
