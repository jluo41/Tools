   "roundness": null,
   "seed": 1514319294,
   "version": 1,
   "versionNonce": 323935659,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MindMap · Status · Findings, as live (261108); Status: the waiting line, then each Task opening to its Runs;\nFindings: 📌 Headlines, then 📚 Papers a side tab a paper, 📖 Evidence Bib its entries then the BibTeX, 🧾 Synthesis the topic summary, 📦 Delivery;\nevery section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms; the right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "originalText": "MindMap · Status · Findings, as live (261108); Status: the waiting line, then each Task opening to its Runs;\nFindings: 📌 Headlines, then 📚 Papers a side tab a paper, 📖 Evidence Bib its entries then the BibTeX, 🧾 Synthesis the topic summary, 📦 Delivery;\nevery section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms; the right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
  },
