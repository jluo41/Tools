  {
   "id": "s-b74c14ed7892",
   "type": "text",
   "x": 1400.0,
   "y": 365.0,
   "width": 2207.2,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
