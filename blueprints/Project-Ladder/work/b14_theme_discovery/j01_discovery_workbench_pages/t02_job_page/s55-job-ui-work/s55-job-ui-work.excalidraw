   "versionNonce": 1268868487,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the same views as Report: ⚙️ Process when it has a step (B 🚧 Next steps), then 📊 Results by the same code;\nC has no Process (no question to answer at a Job); every section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms; the right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "originalText": "the same views as Report: ⚙️ Process when it has a step (B 🚧 Next steps), then 📊 Results by the same code;\nC has no Process (no question to answer at a Job); every section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms; the right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
