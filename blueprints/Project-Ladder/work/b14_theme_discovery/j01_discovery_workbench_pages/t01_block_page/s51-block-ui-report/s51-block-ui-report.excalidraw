   "versionNonce": 1290880007,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MindMap · Status · Findings, as the live discovery page draws them (261108); Findings: one ❓ section per question\ngroup, then 📚 Papers a side tab a paper, 📖 Evidence Bib its entries then the BibTeX, 🧾 Synthesis the topic summary, 📦 Delivery;\nevery section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms; the right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "originalText": "MindMap · Status · Findings, as the live discovery page draws them (261108); Findings: one ❓ section per question\ngroup, then 📚 Papers a side tab a paper, 📖 Evidence Bib its entries then the BibTeX, 🧾 Synthesis the topic summary, 📦 Delivery;\nevery section starts closed (▸), its state word on its right, a waiting line under one that waits on you; what it opens to is drawn under its bar, behind a dashed line;\n🙋 Interaction is every view's last section and holds its own forms; the right rail: Report · Work · Studio · Interactions · Delivery · Timeline · Skills · Files, as served 261108",
   "fontSize": 20,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
