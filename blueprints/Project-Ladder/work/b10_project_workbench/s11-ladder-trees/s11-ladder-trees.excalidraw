   "seed": 1176886776,
   "version": 1,
   "versionNonce": 816545283,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "-> a light Page: fixed skeleton, free prose (like the drawing)\n1  draft/ takes in the discussion as free notes\n2  the person, or an agent, folds them into the .md directly\n3  four fixed headings; anything free goes under them\n4  Evidence cites Job, Task or Run by address\n5  a small check reads the shape: header lines + 4 headings\n   (a check, not a Run; no versions, no realizes tags)",
   "originalText": "-> a light Page: fixed skeleton, free prose (like the drawing)\n1  draft/ takes in the discussion as free notes\n2  the person, or an agent, folds them into the .md directly\n3  four fixed headings; anything free goes under them\n4  Evidence cites Job, Task or Run by address\n5  a small check reads the shape: header lines + 4 headings\n   (a check, not a Run; no versions, no realizes tags)",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-b133e9ff1d4e",
   "type": "text",
   "x": 3260,
   "y": 1440,
   "width": 536.8000000000001,
   "height": 160.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
