ull, "locked": false, "text": "Act 3 · Their own Report\ntoday: paper, insight,\ndesign, discovery", "originalText": "Act 3 · Their own Report\ntoday: paper, insight,\ndesign, discovery", "fontSize": 70, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-83fe5087ae0f", "type": "text", "x": 1400.0, "y": 6277.5, "width": 808.5000000000001, "height": 262.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1438884974, "version": 1, "versionNonce": 1368097083, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Act 4 · How a group\nreaches it, and every\npart", "originalText": "Act 4 · How a group\nreaches it, and every\npart", "fontSize": 70, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-7f7355c3acf2", "type": "text", "x": 1400.0, "y": 8696.875, "width": 885.5000000000001, "height": 175.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1109226045, "version": 1, "versionNonce": 1055045893, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Act 5 · Still open, and\nfor reference", "originalText": "Act 5 · Still open, and\nfor reference", "fontSize": 70, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-d391a704f1ae", "type": "text", "x": 2475.0, "y": 390.0, "width": 7452.500000000001, "height": 62.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 31243411, "version": 1, "versionNonce": 1073528183, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "s05 in one sentence: every level asks its own Questions, the Work that answers one names it, the report says the answer, open → partial → answered ①; the Report Space shows each row while /haipipe-report writes and checks it ②; and every theme groups them on one bar ③ ④.", "originalText": "s05 in one sentence: every level asks its own Questions, the Work that answers one names it, the report says the answer, open → partial → answered ①; the Report Space shows each row while /haipipe-report writes and checks it ②; and every theme groups them on one bar ③ ④.", "fontSize": 50, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-cf5955ffe5c8", "type": "text", "x": 2475.0, "y": 477.5, "width": 892.3750000000001, "height": 34.375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1689452243, "version": 1, "versionNonce": 1069365828, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Read left to right along the arrows, act by act, then down.", "originalText": "Read left to right along the arrows, act by act, then down.", "fontSize": 28, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-6701bac983fc", "type": "text", "x": 2475.0, "y": 540.0, "width": 1467.1683593750001, "height": 28.125, "angle": 0, "strokeColor": "#2f9e44", "backgroundColor": "transparent", "fillStyle": "solid", "s