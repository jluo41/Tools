: {"ui": true}}, {"id": "kept_s-ec66edcf1e9b", "type": "text", "x": 7275.0, "y": 1002.5, "width": 231.0, "height": 37.5, "angle": 0, "strokeColor": "#1c1c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-5665bfc44567", "roundness": null, "seed": 731778947, "version": 1, "versionNonce": 413698560, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Why this order", "originalText": "Why this order", "fontSize": 30, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "customData": {"ui": true}}, {"id": "kept_s-6643347c4a0e", "type": "text", "x": 7275.0, "y": 1057.5, "width": 707.4375, "height": 65.625, "angle": 0, "strokeColor": "#1c1c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-5665bfc44567", "roundness": null, "seed": 1287709872, "version": 1, "versionNonce": 1669525418, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "1  Delivery stays at the right end of the top row\n(s03-D04).", "originalText": "1  Delivery stays at the right end of the top row\n(s03-D04).", "fontSize": 26, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "customData": {"ui": true}}, {"id": "kept_s-cfbc67fba07a", "type": "text", "x": 7275.0, "y": 1143.25, "width": 736.3125000000001, "height": 65.625, "angle": 0, "strokeColor": "#1c1c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-5665bfc44567", "roundness": null, "seed": 890293645, "version": 1, "versionNonce": 562220913, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2  The source row picks a part: the Block, a Job, a\nTask (s03-D06).", "originalText": "2  The source row picks a part: the Block, a Job, a\nTask (s03-D06).", "fontSize": 26, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "customData": {"ui": true}}, {"id": "kept_s-332bf7e56e32", "type": "text", "x": 7275.0, "y": 1229.0, "width": 693.0000000000001, "height": 65.625, "angle": 0, "strokeColor": "#1c1c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-5665bfc44567", "roundness": null, "seed": 835572776, "version": 1, "versionNonce": 70424903, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "3  Sends first: what went out, to whom, draft or\nsent. Only a person writes sent (s03-D05).", "originalText": "3  Sends first: what went out, to whom, draft or\nsent. Only a person writes sent (s03-D05).", "fontSize": 26, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25, "customData": {"ui": true}}, {"id": "kept_s-76ab5d051c87", "type": "text", "x": 7275.0, "y": 1314.7500000000002, "width": 721.875, "height": 65.625, "angle": 0, "strokeColor": "#1c1c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-5665bfc44567", "roundness": null, "seed": 1695404825, "version": 1, "versionNonce": 67480070, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "4  Then the results of the part picked, each one a\ncard with the result inside (③).", "originalText": "4  Then the results of the part picked, each one a\ncard with the result inside (③).", "fontSize": 26, "fontFamily": 6, "textAlign": "left"