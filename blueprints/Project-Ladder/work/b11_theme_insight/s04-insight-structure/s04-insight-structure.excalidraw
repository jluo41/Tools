 "versionNonce": 957065848, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Q02 · How do partitions and pooling show?", "originalText": "Q02 · How do partitions and pooling show?", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": "kept_s-9e16b81e9dda", "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-26c1b49e9e38", "type": "rectangle", "x": 2150.0, "y": 3252.75, "width": 800.0, "height": 125.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "s-41696548c151", "roundness": {"type": 3}, "seed": 1513129063, "version": 1, "versionNonce": 1087290964, "isDeleted": false, "boundElements": [{"type": "text", "id": "kept_s-599c54f34391"}], "updated": 1, "link": null, "locked": false}, {"id": "kept_s-599c54f34391", "type": "text", "x": 2170.0, "y": 3270.25, "width": 730.8, "height": 84.375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": "s-41696548c151", "roundness": null, "seed": 1456371440, "version": 1, "versionNonce": 916256162, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Versions are a second axis beside partitions: versions =\nJobs, partitions = Runs; the cuts are defined in the\nrelease, so a new cut is a new release.", "originalText": "Versions are a second axis beside partitions: versions =\nJobs, partitions = Runs; the cuts are defined in the\nrelease, so a new cut is a new release.", "fontSize": 22, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": "kept_s-26c1b49e9e38", "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-1f588e48c279", "type": "rectangle", "x": 3000.0, "y": 3252.75, "width": 700.0,