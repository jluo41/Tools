5.0, "width": 169.81250000000003, "height": 20.3125, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 1679883823, "version": 1, "versionNonce": 878747179, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "one partition: hard", "originalText": "one partition: hard", "fontSize": 16, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-53d46f5d7fa0", "type": "text", "x": 1475.0, "y": 777.5, "width": 408.37500000000006, "height": 34.375, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 1072942932, "version": 1, "versionNonce": 239034661, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "open points, with my answer", "originalText": "open points, with my answer", "fontSize": 28, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-ce5aaa628bae", "type": "text", "x": 1475.0, "y": 832.5, "width": 1192.125, "height": 26.5625, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 425818690, "version": 1, "versionNonce": 1417253332, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "①  Plan C: a Job = one Prototype release × one data version? (A and B, below, are the earlier options)", "originalText": "①  Plan C: a Job = one Prototype release × one data version? (A and B, below, are the earlier options)", "fontSize": 21, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-558cff4c3b3b", "type": "text", "x": 1520.0, "y": 865.0, "width": 1866.5625000000002, "height": 23.4375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 14992568, "version": 1, "versionNonce": 2041966165, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "→ Yes: the Board holds the Prototype (made once, DIKW as groups) and the dataset; each Job runs one release on one version; a Task is a question in that Job; a Run is one partition.", "originalText": "→ Yes: the Board holds the Prototype (made once, DIKW as groups) and the dataset; each Job runs one release on one version; a Task is a question in that Job; a Run is one partition.", "fontSize": 19, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-2e7e8864026c", "type": "text", "x": 1475.0, "y": 912.5, "width": 701.25, "height": 26.5625, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 734285209, "version": 1, "versionNonce": 469511526, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "②  Is each Prototype release signed by a person (p1, p2, …)?", "originalText": "②  Is each Prototype release signed by a person (p1, p2, …)?", "fontSize": 21, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-444833027abc", "type": "text", "x": 1520.0, "y": 945.0, "width": 1031.2500000000002, "height": 23.4375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 1905901172, "version": 1, "versionNonce": 85067132, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "→ Yes, as a handoff is signed today: the set of live questions and their scripts that a Job may run.", "originalText": "→ Yes, as a handoff is signed today: the set of live questions and their scripts that a Job may run.", "fontSize": 19, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-896cd0c4f9f6", "type": "text", "x": 1475.0, "y": 992.5, "width": 1122.0, "height": 26.5625, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 821441061, "version": 1, "versionNonce": 718208647, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "③  One clock per Job: only the release or only the data version moves between neighbouring Jobs?", "originalText": "③  One clock per Job: only the release or only the data version moves between neighbouring Jobs?", "fontSize": 21, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-8b3d116f2f6c", "type": "text", "x": 1520.0, "y": 1025.0, "width": 1320.0, "height": 23.4375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 1268155380, "version": 1, "versionNonce": 737469988, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "→ Yes, so a change in an answer has one cause: new data, or new code. Backfill (new code on old data) is then just one more Job.", "originalText": "→ Yes, so a change in an answer has one cause: new data, or new code. Backfill (new code on old data) is then just one more Job.", "fontSize": 19, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-7f367b855538", "type": "text", "x": 1475.0, "y": 1072.5, "width": 876.5625, "height": 26.5625, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 1813532417, "version": 1, "versionNonce": 184005886, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "④  Versions: does the data accumulate (0807 holds 0801) or come in batches?", "originalText": "④  Versions: does the data accumulate (0807 holds 0801) or come in batches?", "fontSize": 21, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-6ab9e4296cdc", "type": "text", "x": 1520.0, "y": 1105.0, "width": 1309.6875, "height": 23.4375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 447898938, "version": 1, "versionNonce": 1820226836, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "→ Accumulate: compare versions, never pool them. Batches: may pool, or test as a replication. One field in board.md says which.", "originalText": "→ Accumulate: compare versions, never pool them. Batches: may pool, or test as a replication. One field in board.md says which.", "fontSize": 19, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-dc6eb0d2b03e", "type": "text", "x": 1475.0, "y": 1152.5, "width": 853.1875000000001, "height": 26.5625, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 478198080, "version": 1, "versionNonce": 1056097427, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "⑤  Pages: one page per question per Job, plus a Board answer across Jobs?", "originalText": "⑤  Pages: one page per question per Job, plus a Board answer across Jobs?", "fontSize": 21, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-4873ee501a73", "type": "text", "x": 1520.0, "y": 1185.0, "width": 1031.2500000000002, "height": 23.4375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 106107652, "version": 1, "versionNonce": 1143205419, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "→ Yes: the Job's page answers on its pair; Board › Audience Report says whether it held across Jobs.", "originalText": "→ Yes: the Job's page answers on its pair; Board › Audience Report says whether it held across Jobs.", "fontSize": 19, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-e3676f884619", "type": "text", "x": 1475.0, "y": 1232.5, "width": 654.5, "height": 26.5625, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 622339806, "version": 1, "versionNonce": 1250626504, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "⑥  Today's Check (a question's gates): where does it go?", "originalText": "⑥  Today's Check (a question's gates): where does it go?", "fontSize": 21, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-868db2b36637", "type": "text", "x": 1520.0, "y": 1265.0, "width": 907.5000000000001, "height": 23.4375, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-ffeb1343d362", "roundness": null, "seed": 2131290612, "version": 1, "versionNonce": 904849363, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "→ Chips on each question row: bound · fit · cited · current; the checker is a Board Run.", "originalText": "→ Chips on each question row: bound · fit · cited · current; the checker is a Board Run.", "fontSize": 19, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-f12d84ae2bc4", "type": "text", "x": 1475.0, "y": 1312.5, "width": 444.125, "height": 26.5625, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameI