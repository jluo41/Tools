eted": false, "boundElements": [], "updated": 0, "link": null, "locked": false, "points": [[0.0, 0.0], [40.0, 0.0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"id": "kept_takeaways", "type": "text", "x": 1400.0, "y": 4305.0, "width": 1184.4, "height": 140.625, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 1411020451, "version": 1, "versionNonce": 1105631625, "isDeleted": false, "boundElements": [], "updated": 0, "link": null, "locked": false, "text": "1. Guide explains the family: skills, methods, the UI, the folders. It reads and never runs.\n2. Guide has four views: Description · Method · RoadMap Draw · Related Paper.\n3. Each working Space keeps its Runs panel: pick a run to see its prompt, process and results.\n4. A Design page is one design task and one method; it returns N designs.\n5. The element matrix shows what each design changed, and where each element came from.", "originalText": "1. Guide explains the family: skills, methods, the UI, the folders. It reads and never runs.\n2. Guide has four views: Description · Method · RoadMap Draw · Related Paper.\n3. Each working Space keeps its Runs panel: pick a run to see its prompt, process and results.\n4. A Design page is one design task and one method; it returns N designs.\n5. The element matrix shows what each design changed, and where each element came from.", "fontSize": 22, "fontFamily": 8, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_moved", "type": "rectangle", "x": 2590.0, "y": 4295.0, "width": 1140.0, "height": 220.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacit