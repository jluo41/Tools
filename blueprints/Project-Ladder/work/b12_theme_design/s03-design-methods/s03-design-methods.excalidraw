autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-9b2daf98cead", "type": "text", "x": 3302.5, "y": 4630.0, "width": 163.6375, "height": 20.3125, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-e04b7de5e841", "roundness": null, "seed": 825837949, "version": 1, "versionNonce": 858471907, "isDeleted": false, "boundElements": [], "updated": 1791000000000, "link": null, "locked": false, "text": "observes the result", "originalText": "observes the result", "fontSize": 16, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-a5506be9571c", "type": "rectangle", "x": 1475.0, "y": 4707.5, "width": 2225.0, "height": 120.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-e04b7de5e841", "roundness": {"type": 3}, "seed": 957473606, "version": 1, "versionNonce": 927362216, "isDeleted": false, "boundElements": [], "updated": 1791000000000, "link": null, "locked": false, "containerId": null}, {"id": "kept_s-c11e965f5f98", "type": "text", "x": 1500.0, "y": 4725.0, "width": 715.5, "height": 31.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-e04b7de5e841", "roundness": null, "seed": 670049282, "version": 1, "versionNonce": 46837725, "isDeleted": false, "boundElements": [], "updated": 1791000000000, "link": null, "locked": false, "text": "The open question · which method gives better designs?", "originalText": "The open question · which method gives better designs?", "fontSize": 25, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-84b022db9f70", "type": "text", "x": 1500.0, "y": 4762.5, "width": 1876.2, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": "s-e04b7de5e841", "roundness": null, "seed": 273260902, "version": 1, "versionNonce": 69242372, "isDeleted": false, "boundElements": [], "updated": 1791000000000, "link": null, "locked": false, "text": "No approach has been compared with another (O'Cathain 2019). Design one goal by several registered methods (M01 – M05), review them (④ ⑤, T0 to T2), and let the Exp (T4) answer:\ndoes reading more give better designs, and do our own insights beat the literature?", "originalText": "No approach has been compared with another (O'Cathain 2019). Design one goal by several registered methods (M01 – M05), review them (④ ⑤, T0 to T2), and let the Exp (T4) answer:\ndoes reading more give better designs, and do our own insights beat the literature?", "fontSize": 20, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "containerId": null, "autoResize": true, "lineHeight": 1.25}, {"id": "kept_s-fcb00b805939", "type": "text", "x": 1400.0, "y": 5402.5, "width": 2040.0, "height": 50.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 140722157, "version": 1, "versionNonce": 1300515103, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "2 · The design unit catalog: each step's options, then one row per method (M01 – M05)", "originalText": "2 · The design unit catalog: each step's options, then one row per method (M01 – M05)", "fontSize": 40, "fontFamily": 6, "textAlign": "left", "verticalAlign": "top", "con