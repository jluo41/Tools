    {
      "id": "t-QB6-fig",
      "type": "text",
      "x": 3559.0,
      "y": 2531.0,
      "width": 584.0,
      "height": 375.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-QB6",
