  {
   "id": "t-QE1-fig",
   "type": "text",
   "x": 24.0,
   "y": 3701.0,
   "width": 766.5,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
