    },
    {
      "id": "t-QC4-fig",
      "type": "text",
      "x": 4776,
      "y": 1031,
      "width": 598.6,
      "height": 390,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "frame-QC4",
