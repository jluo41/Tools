  {
   "id": "t-QE2-fig",
   "type": "text",
   "x": 928.0,
   "y": 3701.0,
   "width": 554.8,
   "height": 225.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
