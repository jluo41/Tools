      "text": "QC4a · The write path: one browser edit, one markdown mutation",
      "originalText": "QC4a · The write path: one browser edit, one markdown mutation",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
