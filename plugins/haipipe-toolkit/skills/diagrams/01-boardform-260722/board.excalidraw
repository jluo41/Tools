      "text": "QC4 · The round trip: md to html, and html back to md",
      "originalText": "QC4 · The round trip: md to html, and html back to md",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
