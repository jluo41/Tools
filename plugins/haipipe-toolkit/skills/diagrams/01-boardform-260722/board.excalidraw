      "text": "QE3 · Where the board runs",
      "originalText": "QE3 · Where the board runs",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
