  {
   "id": "t-QE4-fig",
   "type": "text",
   "x": 2438.0,
   "y": 2756.0,
   "width": 737.3,
   "height": 255.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
