   "text": "QA4a \u00b7 One excalidraw per board, one frame per page",
   "originalText": "QA4a \u00b7 One excalidraw per board, one frame per page",
   "fontSize": 18,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
