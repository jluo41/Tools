  {
   "id": "t-QA0-fig",
   "type": "text",
   "x": 24.0,
   "y": 56.0,
   "width": 562.1,
   "height": 780.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
