[paper]
id = "Paper-<slug>"
desk = "<desk><year>"
source_format = "latex-room"
venue_profile = "<venue-profile>"

[pages]
# Authored inputs, outside the generated room. Omit appendix when unused.
main = "../Ba-<desk>-Main"
appendix = "../Bb-<desk>-Appendix"
order = "../A1-Story/StoryA-<desk>-<idea>/StoryA-<desk>-<idea>.md"

[source]
# Generated output only. The builder rejects other rooms and symlink escapes.
room = "latex"
master = "master.tex"
sections = "sections"
appendices = "appendices"
displays = "displays"
bibliography = "reference.bib"

[outputs]
main_docx = "word/<stem>-submission-draft.docx"
supplement_docx = "word/<stem>-online-supplement-draft.docx"
main_pdf = "latex/<stem>-submission-draft.pdf"
supplement_pdf = "latex/<stem>-online-supplement-draft.pdf"
section_snapshots = "word/draft-sections"
assets = "latex/submission-assets"
manifest = "build-manifest.json"

# Optional profile overrides belong here only when the venue profile declares
# them configurable. They never hold manuscript prose or evidence.
[profile]
# main_text_word_limit = 4000
# include_references = true
# include_supplement = true
