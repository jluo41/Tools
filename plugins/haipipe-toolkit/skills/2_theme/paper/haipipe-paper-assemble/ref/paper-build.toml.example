[paper]
id = "Paper-<slug>"
desk = "<desk><year>"
source_format = "latex-room"
venue_profile = "<venue-profile>"

[pages]
# Authored inputs, outside the generated room. Omit appendix when unused.
main = "../Ba-<desk>-Main"
appendix = "../Bb-<desk>-Appendix"
order = "../A1-Story/StoryA-<desk>-<idea>/StoryA-<desk>-<idea>.md"

[source]
# Generated output only. The builder rejects other rooms and symlink escapes.
room = "latex"
master = "master.tex"
sections = "sections"
appendices = "appendices"
displays = "displays"
bibliography = "reference.bib"
# Optional, a paper that owns its LaTeX (SKILL.md § A paper that owns its LaTeX):
# head = "../latex-assets/master-head.tex"          # \documentclass, packages, \title
# opening = "../latex-assets/master-opening.tex"    # after \begin{document}; default \maketitle
# supplement_head = "../latex-assets/supplement-head.tex"
# supplement_opening = "../latex-assets/supplement-opening.tex"
# store = "../displays"                             # a shared display store, each read a G4 blocker

# [evidence]
# draft_includes_unready = true    # a DRAFT prints every Page that has a fragment
# draft_citations = true           # a DRAFT merges each Page's unverified draft Bib, as a G4 blocker

[outputs]
main_docx = "word/<stem>-submission-draft.docx"
supplement_docx = "word/<stem>-online-supplement-draft.docx"
main_pdf = "latex/<stem>-submission-draft.pdf"
supplement_pdf = "latex/<stem>-online-supplement-draft.pdf"
section_snapshots = "word/draft-sections"
assets = "latex/submission-assets"
manifest = "build-manifest.json"

# Optional profile overrides belong here only when the venue profile declares
# them configurable. They never hold manuscript prose or evidence.
[profile]
# main_text_word_limit = 4000
# include_references = true
# include_supplement = true
# appendix_float_numbering = "per-appendix"   # Table A1 … B1 …: floats restart in each lettered appendix (LaTeX and Word); default "continuous"
# appendices = "supplement"   # master.tex main, supplement.tex the appendices, combined.tex both (add supplement_pdf, combined_pdf)
# [profile.latex]
# engine = "pdflatex"         # latexmk -pdf, for a paper head that loads no fontspec
# bibstyle = "naturemag"
# display_page = true        # each display on a page of its own, where the text first cites it
# display_at_first_ref = true # each float after the paragraph that first \ref's it
# float_page = "top"          # default; "center" keeps LaTeX's own centring of a display page
