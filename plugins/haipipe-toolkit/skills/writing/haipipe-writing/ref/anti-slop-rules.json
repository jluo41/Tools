  "regex": [
    {
      "id": "em-dash",
      "pattern": "\\u2014|\\u2013|\\s--\\s",
      "category": "style",
      "weight": 2,
      "note": "Replace with a period, comma, colon, or parentheses. En dashes in numeric ranges become hyphens."
    },
    {
      "id": "curly-double-quotes",
      "pattern": "[\\u201C\\u201D]",
      "category": "style",
      "weight": 1,
      "note": "Weak signal on its own; most editors auto-curl. Counted lightly."
    },
    {
      "id": "emoji",
      "pattern": "[\\u2600-\\u27BF\\u2B00-\\u2BFF\\U0001F300-\\U0001FAFF]",
      "category": "style",
      "weight": 2,
      "note": "Emojis decorating professional prose."
    },
    {
      "id": "negative-parallelism",
      "pattern": "\\bnot (?:just|only|merely)\\b[^.!?\\n]{0,80}?\\bbut\\b",
      "category": "language",
      "weight": 3,
      "note": "It's not just X, but Y. State Y directly."
    },
    {
      "id": "its-not-x-its-y",
      "pattern": "\\b(?:it|this|that)['\\u2019]s not [^.!?\\n]{2,60}[.,;] (?:it|this|that)['\\u2019]s\\b",
      "category": "language",
      "weight": 3,
      "note": "Setup/reveal contrast formula."
    },
    {
      "id": "negative-listing",
      "pattern": "\\bnot an? [^.!?\\n]{2,40}\\. not an? [^.!?\\n]{2,40}\\.",
      "category": "rhetoric",
      "weight": 3,
      "note": "Rhetorical striptease: listing what something is not."
    },
    {
      "id": "ing-tail",
      "pattern": ",\\s+(?:highlighting|underscoring|emphasizing|showcasing|reflecting|symbolizing|ensuring|fostering|demonstrating|illustrating|solidifying|cementing|signaling)\\b",
      "category": "content",
      "weight": 4,
      "note": "Present-participle tail adding fake depth."
    },
    {
      "id": "copula-avoidance",
      "pattern": "\\b(?:serves as|stands as|boasts)\\b",
      "category": "language",
      "weight": 3,
      "note": "Use is/has."
    },
    {
      "id": "vague-attribution",
      "pattern": "\\b(?:experts (?:believe|argue|say)|studies show|industry reports suggest|observers have (?:cited|noted)|some critics argue|it is believed that|it is widely (?:believed|regarded))\\b",
      "category": "content",
      "weight": 4,
      "note": "Name a real source or cut the claim."
    },
    {
      "id": "chatbot-artifact",
      "pattern": "\\b(?:i hope this helps|great question|excellent point|let me know if|would you like me to|feel free to|don['\\u2019]t hesitate to|happy to help|you['\\u2019]re absolutely right|is there anything else)\\b",
      "category": "communication",
      "weight": 5,
      "note": "Chatbot correspondence pasted as content."
    },
    {
      "id": "cutoff-disclaimer",
      "pattern": "\\b(?:as of my last (?:training|knowledge)|knowledge cutoff|while specific details are (?:limited|scarce)|based on available information|maintains a low profile|keeps personal details private)\\b",
      "category": "communication",
      "weight": 4,
      "note": "Cutoff disclaimers and speculative gap-filling."
    },
    {
      "id": "hedging-stack",
      "pattern": "\\b(?:could|may|might) (?:potentially|possibly|perhaps)\\b|\\b(?:potentially|arguably) (?:possibly|perhaps)\\b",
      "category": "filler",
      "weight": 3,
      "note": "One qualifier per claim."
    },
    {
      "id": "generic-conclusion",
      "pattern": "\\b(?:the future looks bright|exciting times lie ahead|only time will tell|the possibilities are endless|poised for growth|watch this space|journey toward excellence|step in the right direction)\\b",
      "category": "filler",
      "weight": 4,
      "note": "End on the last concrete fact instead."
    },
    {
      "id": "significance-inflation",
      "pattern": "\\b(?:marking a pivotal|(?:is|as) a testament to|serves as a reminder|underscor(?:es|ing) the (?:importance|significance)|reflects broader|setting the stage for|key turning point|evolving landscape|indelible mark|deeply rooted)\\b",
      "category": "content",
      "weight": 4,
      "note": "Puffed-up importance claims."
    },
    {
      "id": "throat-clearing",
      "pattern": "\\b(?:here['\\u2019]s the thing|here['\\u2019]s what you need to know|let['\\u2019]s dive in|let['\\u2019]s explore|let['\\u2019]s break (?:this|it) down|without further ado|let that sink in|make no mistake|the uncomfortable truth)\\b",
      "category": "rhetoric",
      "weight": 4,
      "note": "Announcing the point instead of making it."
    },
    {
      "id": "authority-trope",
      "pattern": "\\b(?:at its core|the real question is|what really matters|the heart of the matter|the deeper issue)\\b",
      "category": "rhetoric",
      "weight": 3,
      "note": "Fake depth before an ordinary point."
    },
    {
      "id": "vague-declarative",
      "pattern": "\\bthe (?:implications|stakes|consequences|reasons) are (?:significant|high|real|structural|profound|far-reaching)\\b",
      "category": "rhetoric",
      "weight": 4,
      "note": "Name the specific implication or cut."
    },
    {
      "id": "false-agency",
      "pattern": "\\b(?:the (?:data|numbers) tells? us|the market rewards|the decision emerge[sd]|the culture shift(?:s|ed)|the conversation move[sd] toward)\\b",
      "category": "rhetoric",
      "weight": 3,
      "note": "Name the human doing the thing."
    },
    {
      "id": "inline-header-list",
      "pattern": "^\\s*[-*]\\s+\\*\\*[^*\\n]{2,60}\\*\\*:",
      "flags": "gim",
      "category": "style",
      "weight": 3,
      "note": "Bolded label bullets. Convert to prose or a plain list."
    },
    {
      "id": "oxford-triple",
      "pattern": "\\b\\w+, \\w+, and \\w+\\b",
      "category": "language",
      "weight": 1,
      "note": "Rule of three. Often legitimate; counted lightly and matters in clusters."
    },
    {
      "id": "zh-triplet-shi",
      "pattern": "是[^，。；！？\\n]{1,15}，是[^，。；！？\\n]{1,15}，更是",
      "category": "zh-structure",
      "weight": 3,
      "lang": "zh",
      "source": "VincentOld/stop-slop-zh",
      "note": "排比三件套：保留最有力的一句，其余删去（规则 2）"
    },
    {
      "id": "zh-triplet-jiyao",
      "pattern": "既要[^，。；！？\\n]{1,15}，?又要[^，。；！？\\n]{1,15}，?还要",
      "category": "zh-structure",
      "weight": 3,
      "lang": "zh",
      "source": "VincentOld/stop-slop-zh",
      "note": "既要…又要…还要…：拆成一句或分段（规则 2）"
    },
    {
      "id": "zh-nominalization-jinxing",
      "pattern": "进行了?[\\u4e00-\\u9fff]{2}",
      "category": "zh-nominalization",
      "weight": 2,
      "lang": "zh",
      "source": "VincentOld/stop-slop-zh",
      "note": "“进行 + 动词”几乎总是名词化：直接用那个动词（规则 3）"
    },
    {
      "id": "zh-nominalization-jiayi",
      "pattern": "加以[\\u4e00-\\u9fff]{2}",
      "category": "zh-nominalization",
      "weight": 2,
      "lang": "zh",
      "source": "VincentOld/stop-slop-zh",
      "note": "“加以 + 动词”：直接用那个动词（规则 3）"
    }
  ]
}
