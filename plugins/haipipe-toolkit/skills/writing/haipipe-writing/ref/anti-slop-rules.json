        "unparalleled", "ever-evolving", "game-changer", "game-changing"
      ]
    },
    "tier2": {
      "weight": 3,
      "minDistinct": 2,
      "note": "Suspicious in density. Flagged when two or more distinct terms appear.",
      "words": [
        "additionally", "furthermore", "moreover", "notably",
        "consequently", "subsequently", "accordingly", "nonetheless",
        "comprehensive", "paradigm", "holistic", "holistically",
        "utilize", "utilizes", "utilizing", "utilized",
        "facilitate", "facilitates", "facilitating", "facilitated",
        "nuanced", "elucidate", "illuminate",
        "encompass", "encompasses", "encompassing",
        "streamline", "streamlines", "streamlining", "streamlined",
        "spearhead", "spearheading", "bolster", "bolstering",
        "poised", "cutting-edge", "harness", "harnessing", "harnessed",
        "unleash", "unleashing", "revolutionize", "reimagine",
        "elevate", "elevating", "alleviate", "alleviating",
        "cadence", "quintessential", "ubiquitous", "proactive",
        "endeavor", "endeavour"
      ]
    },
    "tier3": {
      "weight": 1,
      "maxDensityPct": 1.5,
      "note": "Context-dependent. Flagged only when their combined density exceeds maxDensityPct per 100 words.",
      "words": [
        "significant", "effective", "unique", "compelling",
        "exceptional", "essential", "valuable", "innovative", "notable"
      ]
    }
  },
  "phrases": [
