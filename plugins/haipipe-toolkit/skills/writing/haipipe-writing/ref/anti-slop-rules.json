{
  "version": "1.1.0",
  "owner": "haipipe-writing",
  "scope": "diagnostic-only; never an automatic rewrite or acceptance gate",
  "description": "Machine-readable anti-slop rules for the Haipipe writing adapter. Vocabulary tiers adapted from brandonwise/humanizer, phrases from hardikpandya/stop-slop and blader/humanizer. Entries marked `lang: zh` carry the Chinese-register rules adapted from VincentOld/stop-slop-zh; sentence statistics stay English-tuned.",
  "provenance": [
    {
      "source": "aashaexo/soundshuman",
      "path": "rules/slop-rules.json",
      "license": "MIT",
      "role": "base rule data and rule-driven scanner design"
    },
    {
      "source": "hardikpandya/stop-slop",
      "path": "SKILL.md",
      "license": "MIT",
      "role": "structural anti-pattern vocabulary"
    },
    {
      "source": "blader/humanizer",
      "path": "SKILL.md",
      "license": "MIT",
      "role": "pattern categories and no-fabrication boundary"
    },
    {
      "source": "brandonwise/humanizer",
      "license": "MIT",
      "role": "tiered vocabulary and metric rationale"
    },
    {
      "source": "VincentOld/stop-slop-zh",
      "path": "SKILL.md",
      "license": "MIT",
      "role": "Chinese-register rules 1, 2, 3 and 6 (虚词, 排比三件套, 名词化, 元评论与八股连接词) as the `lang: zh` phrase and regex entries"
    }
  ],
  "vocabulary": {
    "tier1": {
      "weight": 5,
      "note": "Dead giveaways. Every occurrence is flagged.",
      "words": [
        "delve", "delves", "delving", "delved",
        "tapestry", "testament", "pivotal", "intricate", "intricacies",
        "showcase", "showcases", "showcasing", "showcased",
        "foster", "fosters", "fostering", "fostered",
        "garner", "garners", "garnered", "garnering",
