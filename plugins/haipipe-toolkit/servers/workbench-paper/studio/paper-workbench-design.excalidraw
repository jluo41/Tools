    {
      "id": "m-rules",
      "type": "text",
      "x": 48,
      "y": 936,
      "width": 1561.2800000000002,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
