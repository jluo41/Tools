      "versionNonce": 130953838,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790801329800,
      "link": null,
      "locked": false,
      "text": "The number is the order inside a Space. A question is written first; its run then creates or continues the folder that answers it (BJTR = Block › Job › Task › Run).\nEach run type names its skill in run-cards.md (🧩 SKILL); a run's own `skills:` line wins. Creating a folder never starts a run: the person presses Run.",
      "originalText": "The number is the order inside a Space. A question is written first; its run then creates or continues the folder that answers it (BJTR = Block › Job › Task › Run).\nEach run type names its skill in run-cards.md (🧩 SKILL); a run's own `skills:` line wins. Creating a folder never starts a run: the person presses Run.",
      "fontSize": 17,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
