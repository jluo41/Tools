    },
    {
      "id": "source-body-0",
      "type": "text",
      "x": 72,
      "y": 2892,
      "width": 663.0400000000001,
      "height": 220.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1868484232,
      "version": 1,
      "versionNonce": 2080251292,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790989751805,
      "link": null,
      "locked": false,
      "text": "The Block declares its Questions and their logic items.\n\nQuestion cards stack vertically; Logic | Work | Report sit side by side.\n\nWork keeps its Task / Run / Result references when execution is involved.\n\nA Question can use several Tasks; shared work can serve several Questions.\n\nReport: answer, exact evidence, limits and next action in the same card.\n\nboard.md binds Questions to native Tasks and Block-owned Report Pages.",
      "originalText": "The Block declares its Questions and their logic items.\n\nQuestion cards stack vertically; Logic | Work | Report sit side by side.\n\nWork keeps its Task / Run / Result references when execution is involved.\n\nA Question can use several Tasks; shared work can serve several Questions.\n\nReport: answer, exact evidence, limits and next action in the same card.\n\nboard.md binds Questions to native Tasks and Block-owned Report Pages.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
