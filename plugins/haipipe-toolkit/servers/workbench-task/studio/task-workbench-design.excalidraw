      "text": "The session and Workbench",
      "originalText": "The session and Workbench",
      "fontSize": 25,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "source-body-1",
      "type": "text",
      "x": 1280,
      "y": 2892,
      "width": 636.1600000000001,
      "height": 180.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 457189540,
      "version": 1,
      "versionNonce": 511179314,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790989751805,
      "link": null,
      "locked": false,
      "text": "Read one Question's Logic, Work and current Report.\n\nCopy its goal, evidence, blockers and next action into the session.\n\nThe session uses the owning Task / Page workflow to change records.\n\nA Question may have reasoning and a Report before any Job / Task / Run.\n\nRoadmap Studio: expand any drawing row to use its freeform canvas.",
      "originalText": "Read one Question's Logic, Work and current Report.\n\nCopy its goal, evidence, blockers and next action into the session.\n\nThe session uses the owning Task / Page workflow to change records.\n\nA Question may have reasoning and a Report before any Job / Task / Run.\n\nRoadmap Studio: expand any drawing row to use its freeform canvas.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
