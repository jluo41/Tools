   "isDeleted": false,
   "boundElements": [],
   "updated": 1790467200000,
   "link": null,
   "locked": false,
   "text": "Goal       →  the design task, once: aim, measure, baseline, constraints\nDesign     →  one card view: Design · Rationale · Supporting work · Expectation\nInsight    →  folded into each card's Rationale and Supporting work\nRun        →  a Runs panel inside every Space\nDelivery   →  this task's passed drafts; the board gathers every task's",
   "originalText": "Goal       →  the design task, once: aim, measure, baseline, constraints\nDesign     →  one card view: Design · Rationale · Supporting work · Expectation\nInsight    →  folded into each card's Rationale and Supporting work\nRun        →  a Runs panel inside every Space\nDelivery   →  this task's passed drafts; the board gathers every task's",
   "fontSize": 15,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "index": "b1t"
