   "isDeleted": false,
   "boundElements": [],
   "updated": 1790826922400,
   "link": null,
   "locked": false,
   "text": "In C-K terms: Knowledge is K, Design is C. A design is a concept\nK cannot yet decide; the test decides it, and its answer is new K.",
   "originalText": "In C-K terms: Knowledge is K, Design is C. A design is a concept\nK cannot yet decide; the test decides it, and its answer is new K.",
   "fontSize": 16,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
