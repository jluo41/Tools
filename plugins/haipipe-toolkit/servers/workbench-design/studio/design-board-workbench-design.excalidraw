   "updated": 1790826922400,
   "link": null,
   "locked": false,
   "text": "How a domain theory enters one design",
   "originalText": "How a domain theory enters one design",
   "fontSize": 24,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "method",
   "type": "text",
   "x": 3370.0,
   "y": 3416,
   "width": 489.59999999999997,
   "height": 255.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame-mt",
   "roundness": null,
   "seed": 1160738058,
   "version": 1,
   "versionNonce": 601206705,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790826922400,
   "link": null,
   "locked": false,
   "text": "Knowledge   theory: why people act\n   ↓\nVariable    the one it moves: the sender\n   ↓\nDesign      change only that, against salience\n   ↓\nBet         expected / wrong if, before the send\n   ↓\nSend        one arm per variable + salience\n   ↓\nInsight     'did changing the sender help?'\n   ↺        the answer joins Knowledge",
   "originalText": "Knowledge   theory: why people act\n   ↓\nVariable    the one it moves: the sender\n   ↓\nDesign      change only that, against salience\n   ↓\nBet         expected / wrong if, before the send\n   ↓\nSend        one arm per variable + salience\n   ↓\nInsight     'did changing the sender help?'\n   ↺        the answer joins Knowledge",
   "fontSize": 17,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
