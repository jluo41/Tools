  {
   "id": "abd-rule",
   "type": "line",
   "x": 3370.0,
   "y": 234,
   "width": 1128,
   "height": 0,
   "angle": 0,
   "strokeColor": "#ced4da",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame-dt",
   "roundness": null,
   "seed": 1201164715,
   "version": 1,
   "versionNonce": 2018590361,
   "isDeleted": false,
   "boundElements": [],
