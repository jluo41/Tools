   "updated": 1790826922400,
   "link": null,
   "locked": false,
   "text": "EAST groups them: Easy, Attractive, Social, Timely (Behavioural Insights Team 2014). Also in use: MINDSPACE (Dolan et al. 2010), Fogg's B = MAP (2009), COM-B (Michie et al. 2011).",
   "originalText": "EAST groups them: Easy, Attractive, Social, Timely (Behavioural Insights Team 2014). Also in use: MINDSPACE (Dolan et al. 2010), Fogg's B = MAP (2009), COM-B (Michie et al. 2011).",
   "fontSize": 15,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
