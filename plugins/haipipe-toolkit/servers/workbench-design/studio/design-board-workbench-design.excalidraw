   "text": "1 · The design problem: abduction",
   "originalText": "1 · The design problem: abduction",
   "fontSize": 26,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
