  {
   "id": "bt-gen-body",
   "type": "text",
   "x": 1127,
   "y": 392,
   "width": 546.0,
   "height": 350.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame-board",
