   "boundElements": [],
   "updated": 1790827717854,
   "link": null,
   "locked": false,
   "text": "Objective      Increase the share of patients who open and review their new prescription\nAudience       All patients in the SMSR2v1 cohort (444,691 invitations)  ·  Measured by: click-through, then identity verification\nBaseline       Round-1 salience message, 66.06% click-through  ·  Every design keeps: ≤ 140 characters · 'Reply STOP to opt-out' · no health detail",
   "originalText": "Objective      Increase the share of patients who open and review their new prescription\nAudience       All patients in the SMSR2v1 cohort (444,691 invitations)  ·  Measured by: click-through, then identity verification\nBaseline       Round-1 salience message, 66.06% click-through  ·  Every design keeps: ≤ 140 characters · 'Reply STOP to opt-out' · no health detail",
   "fontSize": 15,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
