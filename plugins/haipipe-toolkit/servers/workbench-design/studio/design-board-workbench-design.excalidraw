   "boundElements": [],
   "updated": 1790467200000,
   "link": null,
   "locked": false,
   "text": "not commissioned → commission open → commissioned → generate queued\n→ generating → generated → verify queued → verifying → ready\nside exits: commission held · generate failed · verify failed\n            verify invalid · queued run out of date",
   "originalText": "not commissioned → commission open → commissioned → generate queued\n→ generating → generated → verify queued → verifying → ready\nside exits: commission held · generate failed · verify failed\n            verify invalid · queued run out of date",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "index": "b3G"
  },
  {
   "id": "history-takeaways",
   "type": "text",
   "x": 48,
   "y": 5602,
   "width": 887.04,
   "height": 112.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame-ui",
   "roundness": null,
   "seed": 320254183,
   "version": 2,
   "versionNonce": 443233999,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790467200000,
   "link": null,
   "locked": false,
   "text": "1. A person releases the Commission; an agent runs only what is queued.\n2. Verify is a different agent in a fresh context; it can fail a draft or send a note.\n3. A review note or a failed rule becomes feedback on a new Generate; old drafts stay.\n4. Each SMS is judged on its own rules: length, the STOP line, {NAME}, no health detail.\n5. The Board level lists the six audiences; one CSV holds all 56 designs.",
   "originalText": "1. A person releases the Commission; an agent runs only what is queued.\n2. Verify is a different agent in a fresh context; it can fail a draft or send a note.\n3. A review note or a failed rule becomes feedback on a new Generate; old drafts stay.\n4. Each SMS is judged on its own rules: length, the STOP line, {NAME}, no health detail.\n5. The Board level lists the six audiences; one CSV holds all 56 designs.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "index": "b3M"
  },
