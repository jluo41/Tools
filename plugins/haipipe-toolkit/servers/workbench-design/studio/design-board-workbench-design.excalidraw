  {
   "id": "attend-body",
   "type": "text",
   "x": 4578.0,
   "y": 1046,
   "width": 564.48,
   "height": 340.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame-dt",
   "roundness": null,
   "seed": 218051282,
   "version": 1,
   "versionNonce": 1687347314,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790826922400,
   "link": null,
   "locked": false,
   "text": "Attend to\n  • the value: what should change for the person\n  • the frame: which principle should create that value\n  • the variables: name them before making drafts\n  • hard constraints: an option that breaks one is not a design\n  • spread: options that differ in principle, not in surface\n  • the bet: write the prediction before the test\n  • a test that can tell the options apart\n\nDo not\n  • choose only among what was tried before\n  • treat a prediction as knowledge\n  • polish details past what a test can detect\n  • split by audience without a reason it differs\n  • gather knowledge that changes no design\n    (A00: about 5 of 115 pages changed a draft)\n  • narrow before the options are explored",
   "originalText": "Attend to\n  • the value: what should change for the person\n  • the frame: which principle should create that value\n  • the variables: name them before making drafts\n  • hard constraints: an option that breaks one is not a design\n  • spread: options that differ in principle, not in surface\n  • the bet: write the prediction before the test\n  • a test that can tell the options apart\n\nDo not\n  • choose only among what was tried before\n  • treat a prediction as knowledge\n  • polish details past what a test can detect\n  • split by audience without a reason it differs\n  • gather knowledge that changes no design\n    (A00: about 5 of 115 pages changed a draft)\n  • narrow before the options are explored",
   "fontSize": 16,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
