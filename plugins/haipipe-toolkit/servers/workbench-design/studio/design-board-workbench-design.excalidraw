  {
   "id": "lesson",
   "type": "text",
   "x": 3370.0,
   "y": 3202,
   "width": 1170.96,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#b3541e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": "frame-mt",
   "roundness": null,
   "seed": 675792504,
   "version": 1,
   "versionNonce": 1109070075,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1790826922400,
   "link": null,
   "locked": false,
   "text": "Round 1 was already a bake-off of these theories: its 13 arms are named after them. But each arm rewrote the whole message,\nso it tested 13 messages, not 13 theories, and no theory was confirmed or ruled out. A theory helps a design only when\nthe design changes the one variable that theory names and keeps the rest as salience sent it.",
   "originalText": "Round 1 was already a bake-off of these theories: its 13 arms are named after them. But each arm rewrote the whole message,\nso it tested 13 messages, not 13 theories, and no theory was confirmed or ruled out. A theory helps a design only when\nthe design changes the one variable that theory names and keeps the rest as salience sent it.",
   "fontSize": 17,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
