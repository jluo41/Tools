    {
      "id": "takeaways",
      "type": "text",
      "x": 48,
      "y": 1478,
      "width": 816.48,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1076794951,
      "version": 2,
      "versionNonce": 2114209527,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790467200000,
      "link": null,
      "locked": false,
      "text": "1. Each Space shows every SMS; a selected item or page sets the Runs target.\n2. An SMS shows as the text the patient gets, with its length out of 140.\n3. Every SMS names the insight pages it stands on, and whether each is usable.\n4. Rerun and Revise start a new run; an earlier draft is never overwritten.\n5. Delivery lists every SMS whose review passed, word for word; nothing to adopt.",
      "originalText": "1. Each Space shows every SMS; a selected item or page sets the Runs target.\n2. An SMS shows as the text the patient gets, with its length out of 140.\n3. Every SMS names the insight pages it stands on, and whether each is usable.\n4. Rerun and Revise start a new run; an earlier draft is never overwritten.\n5. Delivery lists every SMS whose review passed, word for word; nothing to adopt.",
      "fontSize": 18,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1q"
    },
