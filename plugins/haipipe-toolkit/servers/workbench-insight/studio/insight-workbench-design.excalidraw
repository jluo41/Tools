    {
      "id": "full-report",
      "type": "text",
      "x": 772,
      "y": 2490,
      "width": 280.8,
      "height": 357.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
