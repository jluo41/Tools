    {
      "id": "cross-report",
      "type": "text",
      "x": 3188,
      "y": 2490,
      "width": 304.2,
      "height": 276.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
