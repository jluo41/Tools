      "versionNonce": 1543258034,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790976670560,
      "link": null,
      "locked": false,
      "text": "\n—\n\n\n› Task  Funnel rates\n  1 run · youngmale · ok\n\n\n\n⌄ Task  Funnel rates\n    D02 extract_profile\n      03 funnel_rates ▸ 1 run\n        youngmale  ok   ↗\n\n\n—\n\n\n\n—\n\n\n\n\n—",
      "originalText": "\n—\n\n\n› Task  Funnel rates\n  1 run · youngmale · ok\n\n\n\n⌄ Task  Funnel rates\n    D02 extract_profile\n      03 funnel_rates ▸ 1 run\n        youngmale  ok   ↗\n\n\n—\n\n\n\n—\n\n\n\n\n—",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
