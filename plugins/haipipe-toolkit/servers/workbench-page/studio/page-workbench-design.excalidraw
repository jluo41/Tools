   "boundElements": [],
   "updated": 1790394733456,
   "link": null,
   "locked": false,
   "text": "1. Each Space shows the whole page; a selected paragraph or item sets the Runs target.\n2. Each Space lists its predefined run types, from run-cards.md; + New Run adds one.\n3. Pick a run to see its prompt (copy it to run it yourself), its process and its results.\n4. Rerun starts the same prompt again as a new run; nothing is overwritten.\n5. Only Accept writes a Markdown, as a new version; Delivery only reads.",
   "originalText": "1. Each Space shows the whole page; a selected paragraph or item sets the Runs target.\n2. Each Space lists its predefined run types, from run-cards.md; + New Run adds one.\n3. Pick a run to see its prompt (copy it to run it yourself), its process and its results.\n4. Rerun starts the same prompt again as a new run; nothing is overwritten.\n5. Only Accept writes a Markdown, as a new version; Delivery only reads.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "index": "b1M"
  },
