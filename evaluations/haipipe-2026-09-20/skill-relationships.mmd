        subgraph Peers["Independent first-class peer families"]
            direction LR
            Insight["Insight<br/>evidence-led analysis"]
            Design["Design<br/>creative production"]
        end
    end

    subgraph RunModel["Shared execution model"]
        direction LR
        Workflow["Workflow<br/>list of Runs"]
        Run["Run<br/>bounded, owner-native execution"]
