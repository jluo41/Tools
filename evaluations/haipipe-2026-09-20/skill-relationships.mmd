flowchart LR
    Project["Project<br/>scope and workspace"]
    Board["Board<br/>navigation, routing, status views"]
    Utils["0_utils<br/>shared helper skills"]

    subgraph Owners["Domain workflow owners"]
        direction TB
        Task["Task<br/>internal execution"]
        Discovery["Discovery<br/>external evidence"]
