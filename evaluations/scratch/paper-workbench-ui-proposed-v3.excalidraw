    {
      "id": "notes",
      "type": "text",
      "x": 48,
      "y": 1218,
      "width": 907.2,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1932882978,
      "version": 2,
      "versionNonce": 235101474,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790394733456,
      "link": null,
      "locked": false,
      "text": "1. One Run list for the whole Page, filtered by scope; the Page bar shows all of it.\n2. Each Space lists its predefined run types, from run-cards.md; + New Run adds one.\n3. Pick a run to see its prompt (copy it to run it yourself), its process and its results.\n4. Rerun starts the same prompt again as a new run; nothing is overwritten.\n5. Only Accept writes a Markdown, as a new version; Delivery only reads.",
      "originalText": "1. One Run list for the whole Page, filtered by scope; the Page bar shows all of it.\n2. Each Space lists its predefined run types, from run-cards.md; + New Run adds one.\n3. Pick a run to see its prompt (copy it to run it yourself), its process and its results.\n4. Rerun starts the same prompt again as a new run; nothing is overwritten.\n5. Only Accept writes a Markdown, as a new version; Delivery only reads.",
      "fontSize": 18,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b1M"
    },
