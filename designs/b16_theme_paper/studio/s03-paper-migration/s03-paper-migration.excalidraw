   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "found on disk today:  Sections 65  ·  moved into a version Job 30  ·  still in an old B<x>- group 35  ·  renamed t0N_<title> 30  ·  with a requirement record 37  ·  without one: their Context Run writes it 28  ·  display units 20  ·  display units without preview.pdf 0  ·  with studio/ or reports/ today 1  ·  with a Bib under delivery/latex/draft-bibliography/ 6",
   "originalText": "found on disk today:  Sections 65  ·  moved into a version Job 30  ·  still in an old B<x>- group 35  ·  renamed t0N_<title> 30  ·  with a requirement record 37  ·  without one: their Context Run writes it 28  ·  display units 20  ·  display units without preview.pdf 0  ·  with studio/ or reports/ today 1  ·  with a Bib under delivery/latex/draft-bibliography/ 6",
   "fontSize": 16,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
