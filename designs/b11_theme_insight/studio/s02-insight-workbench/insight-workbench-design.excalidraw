   "roundness": null,
   "seed": 53924316,
   "version": 1,
   "versionNonce": 384392602,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791431790027,
   "link": null,
   "locked": false,
   "text": "A question asks one thing, and its evidence needs form a logic: each need is a premise, and the logic line says how they lead to the answer. A carried question keeps its words; the review judges it by Q1-Q7 and proposes, and the person signs.",
   "originalText": "A question asks one thing, and its evidence needs form a logic: each need is a premise, and the logic line says how they lead to the answer. A carried question keeps its words; the review judges it by Q1-Q7 and proposes, and the person signs.",
   "fontSize": 18,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
