   "isDeleted": false,
   "boundElements": [],
   "updated": 1791431790027,
   "link": null,
   "locked": false,
   "text": "How a question is asked · who asks it, how it is made small, who checks it, who signs it",
   "originalText": "How a question is asked · who asks it, how it is made small, who checks it, who signs it",
   "fontSize": 28,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-48ddf0cc4764",
   "type": "text",
   "x": 6376,
   "y": 506,
   "width": 2439.36,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
