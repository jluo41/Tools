   "boundElements": [],
   "updated": 1791431790027,
   "link": null,
   "locked": false,
   "text": "▾ Data questions         1\n  Question 4                ✅\n  What does chance do to\n  balance?\n\n▾ Information questions  1\n  Question 14               ✅\n  How large is the gap\n  between the partitions?\n\n▾ Knowledge questions    2\n  Question 15               ✅\n  Do the partitions really\n  differ?\n\n  Question 16               ✅\n  Pool them or serve them\n  apart?\n  builds on Knowledge\n  question 15",
   "originalText": "▾ Data questions         1\n  Question 4                ✅\n  What does chance do to\n  balance?\n\n▾ Information questions  1\n  Question 14               ✅\n  How large is the gap\n  between the partitions?\n\n▾ Knowledge questions    2\n  Question 15               ✅\n  Do the partitions really\n  differ?\n\n  Question 16               ✅\n  Pool them or serve them\n  apart?\n  builds on Knowledge\n  question 15",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-b65caf8f3ee1",
   "type": "text",
   "x": 2838,
   "y": 2901.75,
   "width": 241.79999999999998,
   "height": 260.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
