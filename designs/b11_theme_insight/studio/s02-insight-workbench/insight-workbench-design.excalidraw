   "versionNonce": 63094246,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791431790027,
   "link": null,
   "locked": false,
   "text": "▸ Data questions         4  ✅\n▾ Information questions 18\n\n▾ Question 2                ✅\n  How does each message\n  perform?\n  builds on Data questions 2, 3\n\n  Question 4                ✅\n  Engagement over time?\n  builds on Data question 3\n\n▾ Knowledge questions   16\n\n  Question 2                ✅\n  Should messages be\n  segmented?\n  builds on Information\n  questions 7, 8, 9, 11, 18\n\n  Question 10               🚫\n  Differ across cultural\n  groups?\n\n▸ Wisdom questions       2  ✅",
   "originalText": "▸ Data questions         4  ✅\n▾ Information questions 18\n\n▾ Question 2                ✅\n  How does each message\n  perform?\n  builds on Data questions 2, 3\n\n  Question 4                ✅\n  Engagement over time?\n  builds on Data question 3\n\n▾ Knowledge questions   16\n\n  Question 2                ✅\n  Should messages be\n  segmented?\n  builds on Information\n  questions 7, 8, 9, 11, 18\n\n  Question 10               🚫\n  Differ across cultural\n  groups?\n\n▸ Wisdom questions       2  ✅",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-fe3dfdb3bd77",
   "type": "text",
   "x": 422,
   "y": 2901.75,
   "width": 226.2,
   "height": 341.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
