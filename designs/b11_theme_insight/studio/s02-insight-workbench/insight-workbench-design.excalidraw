   "version": 1,
   "versionNonce": 1265662126,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791431790027,
   "link": null,
   "locked": false,
   "text": "\n\n\n⌄ Question 2's run\n  1 partition · full\n    2-Information ›\n      I02-variant-performance\n        full  ok   ↗\n› Question 4's run\n  1 partition · full · ok\n\n\n\n\n› Runs behind it\n  5 runs, from the\n  questions it builds on\n\n\n\n—",
   "originalText": "\n\n\n⌄ Question 2's run\n  1 partition · full\n    2-Information ›\n      I02-variant-performance\n        full  ok   ↗\n› Question 4's run\n  1 partition · full · ok\n\n\n\n\n› Runs behind it\n  5 runs, from the\n  questions it builds on\n\n\n\n—",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-a51f8f1191d3",
   "type": "text",
   "x": 772,
   "y": 2901.75,
   "width": 280.8,
   "height": 357.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
