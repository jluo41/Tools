  {
   "id": "s-8d8d1ff9db78",
   "type": "text",
   "x": 48,
   "y": 1274,
   "width": 2570.4,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
