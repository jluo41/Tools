   "seed": 561063564,
   "version": 1,
   "versionNonce": 1624519862,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791431790027,
   "link": null,
   "locked": false,
   "text": "\n› Question 4's run\n  1-Data › D04-expected-balance\n  ▸ cross · 5 partitions\n\n\n› Question 14's run\n  cross  ok   ↗\n\n\n\n—\n\n\n\n—",
   "originalText": "\n› Question 4's run\n  1-Data › D04-expected-balance\n  ▸ cross · 5 partitions\n\n\n› Question 14's run\n  cross  ok   ↗\n\n\n\n—\n\n\n\n—",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "s-ed7497bbe644",
   "type": "text",
   "x": 3188,
   "y": 2901.75,
   "width": 304.2,
   "height": 276.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
