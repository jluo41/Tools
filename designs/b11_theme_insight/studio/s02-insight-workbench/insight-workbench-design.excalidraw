  {
   "id": "s-ab20b9a7b903",
   "type": "text",
   "x": 1280,
   "y": 4021.75,
   "width": 1104.0,
   "height": 240.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
