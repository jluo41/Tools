   "roundness": null,
   "seed": 1304958125,
   "version": 1,
   "versionNonce": 358257278,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1791431790027,
   "link": null,
   "locked": false,
   "text": "\nChance balance, cut by cut\nthe deviation each cut's size allows\n\n\n\nThe gap between the cuts\nsame best and worst message in all\nsix cuts\n\n\nThe cuts differ in size, not in\nwhich message wins\n\n\nOne story: pool the cuts\nPOOL · every Wisdom answer waits for it",
   "originalText": "\nChance balance, cut by cut\nthe deviation each cut's size allows\n\n\n\nThe gap between the cuts\nsame best and worst message in all\nsix cuts\n\n\nThe cuts differ in size, not in\nwhich message wins\n\n\nOne story: pool the cuts\nPOOL · every Wisdom answer waits for it",
   "fontSize": 13,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
