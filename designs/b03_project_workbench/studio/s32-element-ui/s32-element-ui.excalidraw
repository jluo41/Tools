   "updated": 1,
   "link": null,
   "locked": false,
   "text": "· the level row is the page index, as a site's navigation: a thin rule under it; the title is the page's own title, larger (26px), with a wide gap above and below it (JL 261008: \"make the gap larger\")",
   "originalText": "· the level row is the page index, as a site's navigation: a thin rule under it; the title is the page's own title, larger (26px), with a wide gap above and below it (JL 261008: \"make the gap larger\")",
